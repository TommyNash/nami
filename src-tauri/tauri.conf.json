{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nami",
  "version": "0.2.1",
  "identifier": "app.nami.desktop",
  "mainBinaryName": "Nami",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nami",
        "width": 1360,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0e0e0e",
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.mds.yandex.net https://*.yandex.net; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../extension": "extension/"
    },
    "icon": [
      "icons/Assets.car",
      "icons/Icon.icon",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
